# Point this at your deployed Laravel API. Leave unset in local dev —
# Vite's proxy (see vite.config.js) forwards /api to http://localhost:8000.
# For production on Vercel, set VITE_API_URL to your backend API URL:
VITE_API_URL=https://scheduling-system-2.onrender.com/api
# Public reCAPTCHA v3 site key. Required for password login when CAPTCHA is enabled.
VITE_RECAPTCHA_SITE_KEY=
